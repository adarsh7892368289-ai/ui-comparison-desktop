{
  "name": "ui-comparison-desktop",
  "version": "1.0.0",
  "description": "Cross-browser visual regression desktop app — port of UI Comparison Chrome Extension",
  "author": "UI Comparison Desktop",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"electron .\"",
    "watch:main": "webpack --config webpack.main.config.js --watch",
    "watch:renderer": "webpack --config webpack.renderer.config.js --watch",
    "build:extractor": "webpack --config webpack.extractor.config.js",
    "build:main": "webpack --config webpack.main.config.js",
    "build:renderer": "webpack --config webpack.renderer.config.js",
    "prebuild": "node scripts/check-env.js",
    "prepackage": "node -e \"if(!process.env.PLAYWRIGHT_BROWSERS_PATH){console.error('PLAYWRIGHT_BROWSERS_PATH not set');process.exit(1)}\"",
    "build": "npm run build:extractor && npm run build:main && npm run build:renderer",
    "smoke-test": "electron . --smoke-test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "install:browsers": "playwright install chromium firefox webkit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron-log": "^5.1.2",
    "electron-updater": "^6.3.0",
    "p-limit": "^4.0.0",
    "playwright": "^1.48.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-loader": "^9.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "fake-indexeddb": "^6.2.5",
    "madge": "^8.0.0",
    "prettier": "^3.2.5",
    "webpack": "^5.96.0",
    "webpack-cli": "^5.1.4"
  }
}
